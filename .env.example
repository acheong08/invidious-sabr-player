# Proxy Configuration
# These environment variables configure the proxy server used to bypass CORS restrictions
# when accessing YouTube's APIs. They are set at build time and cannot be changed at runtime.

# Protocol to use for proxy connections (http or https)
# Default: https
VITE_PROXY_PROTOCOL=https

# Proxy server hostname or IP address
# Default: kube.duti.dev
VITE_PROXY_HOST=kube.duti.dev

# Proxy server port number
# Default: 443
VITE_PROXY_PORT=443

# Base path for proxy requests (e.g., /api for routing through /api/)
# Default: empty string (root path)
VITE_PROXY_BASE_PATH=/api

# Usage:
# 1. Copy this file to .env or .env.local to customize settings
# 2. Vite automatically loads .env files - no additional configuration needed
# 3. If no .env file exists, the defaults above will be used
# 4. These values are embedded into the application at build time
# 5. The ytc-bridge browser extension will override these settings if installed
#
# For local development with the included proxy server (proxy/deno.ts), use:
#   VITE_PROXY_PROTOCOL=http
#   VITE_PROXY_HOST=localhost
#   VITE_PROXY_PORT=8080
#   VITE_PROXY_BASE_PATH=
#
# For Docker deployment (both frontend and proxy in same container), use:
#   VITE_PROXY_PROTOCOL=http
#   VITE_PROXY_HOST=localhost
#   VITE_PROXY_PORT=80
#   VITE_PROXY_BASE_PATH=/api